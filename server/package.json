{
  "name": "gestion-usuarios-roles-server",
  "version": "1.0.0",
  "private": true,
  "description": "API de autenticación y control de acceso por roles",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
